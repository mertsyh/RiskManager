{
  "gpaf_log_format": "1.0",
  "stored_as": "One JSON event per line (JSONL .jsonl file). This template shows the event shape; the player categories are assigned in the team tool, not inside the log.",
  "event_fields": {
    "ts": "ISO-8601 timestamp e.g. 2026-05-01T09:00:00Z",
    "playerPseudoId": "stable pseudonymous id (NOT a name or student number)",
    "sessionId": "groups events of one play session",
    "gameId": "the team GM-... code",
    "eventType": "session_start | score_update | level_complete | session_end (others allowed)",
    "payload": "object; score_update uses payload.score (number); session_end may use payload.completed"
  },
  "player_categories": [
    "class-member",
    "test",
    "prototype",
    "external"
  ],
  "example_events": [
    {
      "ts": "2026-05-01T09:00:00Z",
      "playerPseudoId": "p001",
      "sessionId": "s1",
      "gameId": "GM-XXXXXXXXXXXX",
      "eventType": "session_start",
      "payload": {}
    },
    {
      "ts": "2026-05-01T09:00:30Z",
      "playerPseudoId": "p001",
      "sessionId": "s1",
      "gameId": "GM-XXXXXXXXXXXX",
      "eventType": "score_update",
      "payload": {
        "score": 5
      }
    },
    {
      "ts": "2026-05-01T09:01:35Z",
      "playerPseudoId": "p001",
      "sessionId": "s1",
      "gameId": "GM-XXXXXXXXXXXX",
      "eventType": "level_complete",
      "payload": {
        "level": 1
      }
    },
    {
      "ts": "2026-05-01T09:01:40Z",
      "playerPseudoId": "p001",
      "sessionId": "s1",
      "gameId": "GM-XXXXXXXXXXXX",
      "eventType": "session_end",
      "payload": {
        "completed": true
      }
    }
  ]
}